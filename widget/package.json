{
  "name": "widget",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:app": "vite build --watch --mode development",
    "dev:loader": "vite build -c vite.loader.config.ts --watch --mode development",
    "dev:demo": "vite -c vite.demo.config.ts",
    "build": "vite build && vite build -c vite.loader.config.ts && node scripts/check-size.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "gateway": "workspace:*",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "marked": "^18.2.0",
    "preact": "^11.2.0",
    "zod": "^4.6.7"
  }
}
