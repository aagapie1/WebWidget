# Local admin interface (E4b.1, ADR 008): a second gateway on :3100 with Postgres and Keycloak.
# Loaded after .env (later files win). Development values only (deploy/keycloak, dev compose).
PORT=3100
PUBLIC_ORIGIN=http://localhost:3100
TENANT_SOURCE=postgres
DATABASE_URL=postgres://widget_app:dev-widget-app@localhost:55432/widget
REDIS_URL=redis://localhost:6379
ADMIN_AUTH_CONFIG=../config/server/admin-auth.yaml
ADMIN_OIDC_SECRET_PILOT=dev-secret-pilot-admin-ui
ADMIN_OIDC_SECRET_DEMO_PRIMARIE=dev-secret-demo-primarie-admin-ui
ADMIN_OIDC_SECRET_PLATFORM=dev-secret-platform-admin-ui
# The audit log's Keycloak import (E5 B9): the realms' read-only events clients (dev values).
ADMIN_AUDIT_SECRET_PILOT=dev-audit-reader-pilot
ADMIN_AUDIT_SECRET_DEMO_PRIMARIE=dev-audit-reader-demo-primarie
ADMIN_AUDIT_SECRET_PLATFORM=dev-audit-reader-platform
