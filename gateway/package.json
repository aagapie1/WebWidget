{
  "name": "gateway",
  "private": true,
  "type": "module",
  "exports": {
    "./protocol": "./src/protocol/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "config:check": "tsx src/cli/config-check.ts ../config/tenants ../e2e/tenants",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/db.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/cli/db.ts seed"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "redis": "^6.3.1",
    "undici": "^8.12.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
