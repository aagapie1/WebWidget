# Copy to gateway/.env and fill in. Never commit .env.

# Server
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Public origin of the gateway (the iframe and /api/* live here). Requests to /api/* must come from it.
PUBLIC_ORIGIN=http://localhost:3000

# Directory with tenant configuration files (*.yaml), relative to the gateway working directory.
TENANTS_DIR=../config/tenants
# Built widget served under /w/ (pnpm build, or vite build --watch in pnpm dev).
WIDGET_DIST_DIR=../widget/dist

# Secret used to sign the anonymous visitor cookie (at least 32 random characters).
VISITOR_COOKIE_SECRET=

# Dify — pilot instance (SSH tunnel). Referenced from config/tenants/pilot.yaml.
DIFY_BASE_URL=http://localhost:8080/v1
DIFY_API_KEY_PILOT=
