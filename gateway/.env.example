# Copy to gateway/.env and fill in. Never commit .env.

# Server
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Public origin of the gateway (the iframe and /api/* live here). Requests to /api/* must come from it.
PUBLIC_ORIGIN=http://localhost:3000

# Directory with tenant configuration files (*.yaml), relative to the gateway working directory.
TENANTS_DIR=../config/tenants
# Built widget served under /w/ (pnpm build, or vite build --watch in pnpm dev).
WIDGET_DIST_DIR=../widget/dist

# Secret used to sign the anonymous visitor cookie (at least 32 random characters).
VISITOR_COOKIE_SECRET=

# Dify — pilot instance (SSH tunnel). Referenced from config/tenants/pilot.yaml.
DIFY_BASE_URL=http://localhost:8080/v1
DIFY_API_KEY_PILOT=

# Redis: closing feedback with retention (ADR 005), rate limiting later. Required in production.
# REDIS_URL=redis://localhost:6379

# Admin interface (E4b, ADR 008). Development values match deploy/keycloak (test only).
# TENANT_SOURCE=file            # file | postgres
# DATABASE_URL=postgres://widget_app:dev-widget-app@localhost:55432/widget
# DATABASE_OWNER_URL=postgres://widget_owner:dev-widget-owner@localhost:55432/widget
# Integration tests use a separate database (they truncate tables):
# TEST_DATABASE_URL=postgres://widget_app:dev-widget-app@localhost:55432/widget_test
# TEST_DATABASE_OWNER_URL=postgres://widget_owner:dev-widget-owner@localhost:55432/widget_test
# Built admin interface (default ../admin/dist). For a local admin gateway on :3100 use
# `pnpm --filter gateway dev:admin`, which also loads gateway/admin-dev.env.
# ADMIN_DIST_DIR=../admin/dist
# ADMIN_AUTH_CONFIG=../config/server/admin-auth.yaml
# Admin hosts that belong to one organisation: its sign-in page names it and hides the code field.
# ADMIN_ORG_HOSTS=admin.primaria-exemplu.ro=primaria-exemplu
# ADMIN_OIDC_SECRET_PILOT=dev-secret-pilot-admin-ui
# ADMIN_OIDC_SECRET_DEMO_PRIMARIE=dev-secret-demo-primarie-admin-ui
# ADMIN_OIDC_SECRET_PLATFORM=dev-secret-platform-admin-ui
# Admin login integration tests against the local Keycloak (gateway/test/admin-keycloak.test.ts):
# TEST_KEYCLOAK_URL=http://localhost:8081
