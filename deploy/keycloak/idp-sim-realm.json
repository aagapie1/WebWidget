{
  "realm": "idp-sim",
  "displayName": "IdP simulat (client)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "ssoSessionMaxLifespan": 28800,
  "ssoSessionIdleTimeout": 28800,
  "accessTokenLifespan": 300,
  "internationalizationEnabled": true,
  "supportedLocales": ["ro", "en"],
  "defaultLocale": "ro",
  "groups": [
    {
      "name": "Chatbot-Administratori"
    },
    {
      "name": "Chatbot-Editori"
    },
    {
      "name": "Contabilitate"
    }
  ],
  "clients": [
    {
      "clientId": "pilot-broker",
      "name": "Keycloak broker (realm pilot)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-secret-idp-sim-pilot-broker",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8081/realms/pilot/broker/idp-sim/endpoint"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "dev-idp-alice-Pass1",
          "temporary": false
        }
      ],
      "groups": ["/Chatbot-Administratori"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Editor",
      "credentials": [
        {
          "type": "password",
          "value": "dev-idp-bob-Pass1",
          "temporary": false
        }
      ],
      "groups": ["/Chatbot-Editori"]
    },
    {
      "username": "carol",
      "enabled": true,
      "emailVerified": true,
      "email": "carol@example.test",
      "firstName": "Carol",
      "lastName": "Contabil",
      "credentials": [
        {
          "type": "password",
          "value": "dev-idp-carol-Pass1",
          "temporary": false
        }
      ],
      "groups": ["/Contabilitate"]
    }
  ]
}
